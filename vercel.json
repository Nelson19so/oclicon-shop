{
    "version": 2,
    "builds": [
        {
            "src": "src/config/wsgi.py",
            "use": "@vercel/python"
        },
        {
            "src": "build.sh",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "staticfiles"
            }
        }
    ],
    "functions": {
        "src/config/wsgi.py": {
            "includeFiles": "src/apps/**"
        }
    },
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "staticfiles/$1"
        },
        {
            "src": "/(.*)",
            "dest": "src/config/wsgi.py"
        }
    ]
}
