{
  "version": 2,
  "builds": [
    {
      "src": "build.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    },
    {
      "src": "src/config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "src/**"
      }
    }
  ],
  "env": {
    "PYTHONPATH": ".:src"
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "src/config/wsgi.py"
    }
  ]
}
